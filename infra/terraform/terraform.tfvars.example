# Copy this file to terraform.tfvars and fill in your OCIDs.
# terraform.tfvars is gitignored and must NOT be committed.

tenancy_ocid   = "ocid1.tenancy.oc1..aaaa..."
user_ocid      = "ocid1.user.oc1..aaaa..."
fingerprint    = "aa:bb:cc:dd:ee:ff:..."
compartment_id = "ocid1.tenancy.oc1..aaaa..."  # same as tenancy for root compartment

region = "eu-madrid-1"

# Always Free limits: 2 OCPUs and 12 GB memory max for VM.Standard.A1.Flex
instance_ocpus        = 2
instance_memory_gbs   = 12

# SSH public key path (used to allow passwordless login to the VM)
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
