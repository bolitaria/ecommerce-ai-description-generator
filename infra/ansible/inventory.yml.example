# Copy this file to inventory.yml and fill in the IP of your Oracle VM.
# inventory.yml is gitignored (contains real IPs).
#
# Usage:
#   cp inventory.yml.example inventory.yml
#   # edit with your VM's public IP
#   ansible-playbook -i inventory.yml playbook.yml

all:
  hosts:
    oracle-vm:
      ansible_host: "CHANGE_ME_PUBLIC_IP"
      ansible_user: ubuntu
      ansible_ssh_private_key_file: ~/.ssh/id_ed25519
