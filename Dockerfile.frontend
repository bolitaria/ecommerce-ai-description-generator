FROM --platform=$BUILDPLATFORM node:20-alpine AS builder
WORKDIR /app
COPY web/package*.json ./
RUN npm install
COPY web/ .
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# The official nginx image processes every *.template file in
# /etc/nginx/templates/ through envsubst at container start, and writes
# the result to /etc/nginx/conf.d/. This lets us pass BACKEND_HOST and
# BACKEND_PORT at runtime without rebuilding the image.
COPY web/nginx.conf.template /etc/nginx/templates/default.conf.template

# Sensible defaults for docker-compose. Overridden in Kubernetes.
ENV BACKEND_HOST=backend \
    BACKEND_PORT=8080

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
